# P3 manual install. Superseded by packaging/lxc/install.sh once P2 lands.
# Replaces the packaged ExecStart: plain HTTP for a throwaway test rig, no TLS, the inventory read-only.
# An off-loopback bind needs --allowed-host and --allowed-origin (mecmcp-runtime refuses startup without
# them); an origin is scheme://authority with no path.
# The audit flags are deliberately restated: resetting ExecStart drops every flag of the packaged unit. The HMAC
# redaction flags are left out on purpose (no key on a rig; P2's dry run covers the full packaged baseline).
[Service]
ExecStart=
ExecStart=/usr/local/bin/rustopnsmcp \
    --device-mapping /etc/rustopnsmcp/devices.json \
    --tokens-file /var/lib/rustopnsmcp/tokens.json \
    --state-file /var/lib/rustopnsmcp/changeset-state.json \
    --transport streamable-http --host @RIG_IP@ --port 30037 --allow-insecure-bind \
    --allowed-host @RIG_IP@ --allowed-host @RIG_IP@:30037 \
    --allowed-host @RIG_NAME@ --allowed-host @RIG_NAME@:30037 \
    --allowed-origin http://@RIG_IP@:30037 --allowed-origin http://@RIG_NAME@:30037 \
    --audit-format json --audit-log-file /var/lib/rustopnsmcp/audit.jsonl --audit-journald \
    --inventory-readonly @LAB_MODE@
EnvironmentFile=
